{
  "fast_track": {
    "enabled": true,
    "allow_slash_fast": true,
    "auto_classify": true
  },
  "brainstorm": {
    "enabled": true,
    "allow_promote_to_plan": true
  },
  "token_budget": {
    "enabled": true,
    "soft_limit": 50000,
    "warn_at": 0.75,
    "context_checkpoint_at": 0.75
  },
  "pipeline": {
    "require_plan_approval": true,
    "require_plan_always": true,
    "success_threshold": 95,
    "default_max_retries": 2
  },
  "herald_pipeline": {
    "enabled": true,
    "phases": {
      "1_planning": { "required": true, "steps": ["pm_brief", "ba", "pm_summary", "architect"] },
      "2_design": { "required": false, "condition": "ui_changes", "agents": ["ui_designer", "content_writer"], "execution": "parallel" },
      "3_development": { "required": false, "steps": ["db_agent", "backend_agent", "frontend_agent"], "execution": "sequential" },
      "4_testing": { "required": false, "condition": "any_phase_3", "agents": ["ui_tester", "qa_happy", "qa_breaker", "security_agent"], "execution": "parallel", "max_rounds": 3 },
      "5_data_review": { "required": false, "condition": "schema_changes", "agents": ["data_agent"] },
      "6_marketing": { "required": false, "condition": "customer_facing", "agents": ["marketing_agent", "content_auditor"], "execution": "parallel" },
      "7_documentation": { "required": true, "steps": ["doc_agent", "commit_push"] },
      "8_post_release": { "required": false, "condition": "deploy_confirmed", "agents": ["post_release_agent"] }
    },
    "phase_selection_table": {
      "ui_changes": [2, 3],
      "schema_changes": [3, 5],
      "api_changes": [3],
      "frontend_changes": [3],
      "any_phase_3": [4],
      "customer_facing": [6],
      "any_agent_ran": [7],
      "deploy_confirmed": [8]
    },
    "minimum_pipeline": [1, 7],
    "maximum_pipeline": [1, 2, 3, 4, 5, 6, 7, 8]
  },
  "version": "2.0"
}
